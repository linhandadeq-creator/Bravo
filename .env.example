# ---- Backend ----
DATABASE_URL=postgresql+psycopg2://neoantigen:neoantigen@postgres:5432/neoantigen
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Database ----
POSTGRES_USER=neoantigen
POSTGRES_PASSWORD=neoantigen
POSTGRES_DB=neoantigen
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- Ports ----
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Annotation ----
ANNOTATION_DEFAULT_PROVIDER=mock
ALLOWED_CONSEQUENCES=missense,frameshift,stop_gained

# ---- Upload limits ----
# Streamed upload limit (bytes) for tumour/normal VCFs and project files.
# Default 3 GiB — sized for whole-genome tumour/normal VCFs.
MAX_UPLOAD_BYTES=3221225472
# In-memory upload limit (bytes) for HLA / expression text tables.
# Kept small to avoid exhausting memory. Default 64 MiB.
MAX_TEXT_UPLOAD_BYTES=67108864

# ---- Self-protein off-target filter ----
# Path to a human reference proteome FASTA (e.g. UniProt reviewed). When set,
# candidate peptides matching the self proteome are filtered out.
HUMAN_PROTEOME_FASTA=

# ---- MS / measured-ligand evidence ----
# Optional path to an MS/ligand evidence CSV(.bz2). Empty = auto-detect the
# MHCflurry bundled public MS training data.
EVIDENCE_MS_TRAINING=
